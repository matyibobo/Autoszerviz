@page
@model Autoszerviz.Pages.JavitasPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Javitas</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group">
                <label asp-for="Javitas.UgyfelId">
                    Ügyfél
                </label>

                <select asp-for="Javitas.UgyfelId"
                        asp-items="Model.UgyfelLista"
                        class="form-control">
                    <option value="">-- Válassz ügyfelet --</option>
                </select>

                <span asp-validation-for="Javitas.UgyfelId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Javitas.Rendszam"></label>
                <input asp-for="Javitas.Rendszam"
                       class="form-control" />
                <span asp-validation-for="Javitas.Rendszam"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Javitas.Leiras"></label>
                <textarea asp-for="Javitas.Leiras"
                          class="form-control"></textarea>
                <span asp-validation-for="Javitas.Leiras"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Javitas.Koltseg"></label>
                <input asp-for="Javitas.Koltseg"
                       class="form-control" />
                <span asp-validation-for="Javitas.Koltseg"
                      class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">
                Mentés
            </button>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
