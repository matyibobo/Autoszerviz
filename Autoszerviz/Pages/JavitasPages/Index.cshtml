@page
@model Autoszerviz.Pages.JavitasPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Javítások</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label for="allapot" class="col-form-label">Állapot szűrése</label>
    </div>
    <div class="col-auto">
        <select id="allapot" name="Allapot" class="form-select">
            <option value="">Összes</option>
            @foreach (var allapot in Model.Allapotok)
            {
                <option value="@allapot" selected="@(Model.Allapot == allapot ? "selected" : null)">@allapot</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Szűrés</button>
    </div>
</form>

@if (TempData["Hiba"] is string hiba)
{
    <div class="alert alert-danger">@hiba</div>
}

<p>
    <a asp-page="Create">Felvétel</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Ugyfel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Rendszam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Leiras)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Koltseg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Allapot)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].FelvetelDatuma)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Javitas) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Ugyfel.Nev)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rendszam)
            </td>
            <td>
                @Html.DisplayFor(model => item.Leiras)
            </td>
            <td>
                @Html.DisplayFor(model => item.Koltseg)
            </td>
            <td>
                @Html.DisplayFor(model => item.Allapot)
            </td>
            <td>
                @Html.DisplayFor(model => item.FelvetelDatuma)
            </td>
            <td>
                @if (item.Allapot != "Kész")
                {
                    <form method="post" asp-page-handler="AllapotLepes" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="allapot" value="@Model.Allapot" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Állapot léptetése</button>
                    </form>
                }
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerkesztés</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Részletek</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
