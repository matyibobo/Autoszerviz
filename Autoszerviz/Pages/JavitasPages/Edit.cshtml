@page
@model Autoszerviz.Pages.JavitasPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Szerkesztés</h1>

<h4>Javitas</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Javitas.Id" />
            <div class="form-group">
                <label asp-for="Javitas.UgyfelId" class="control-label">Ügyfél</label>
                <select asp-for="Javitas.UgyfelId" asp-items="Model.UgyfelLista" class="form-control" aria-required="true">
                    <option value="">-- Válassz ügyfelet --</option>
                </select>
                <span asp-validation-for="Javitas.UgyfelId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Rendszam" class="control-label"></label>
                <input asp-for="Javitas.Rendszam" class="form-control" aria-required="true"/>
                <span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Leiras" class="control-label"></label>
                <input asp-for="Javitas.Leiras" class="form-control" />
                <span asp-validation-for="Javitas.Leiras" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Koltseg" class="control-label"></label>
                <input asp-for="Javitas.Koltseg" class="form-control" type="number" step="1" min="0" asp-format="{0:0}" />
                <span asp-validation-for="Javitas.Koltseg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Vissza</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
